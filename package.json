{
  "name": "raytracer-browser-checks",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.js",
    "test:layout": "playwright test --config tests/browser/playwright.config.js telegram.spec.js --project mobile",
    "format": "prettier --write \"web/*.{js,html}\" \"tests/**/*.{js,mjs,html}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"web/*.{js,html}\" \"tests/**/*.{js,mjs,html}\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.6.2"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100
  }
}
